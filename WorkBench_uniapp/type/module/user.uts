// 登录请求DTO
export type LoginDTO = {
	account : string;// userName  email  phone
	password : string;
	remember ?: boolean;// 记住我
}

// 用户数据展示
export type UserInfoVO = {
	userName : string;
	nickName : string;
	avatar : string;
	email : string;
	phone : string,
	gender : string;
	birthday : number;
	signature : string;
	theme : string;
}

// 登录成功后的数据展示
export type LoginUser = {
	token : string;
}
