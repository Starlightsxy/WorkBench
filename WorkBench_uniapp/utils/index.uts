import { Bill } from "../type"

/**
 * 根据秒级时间戳，判断账单时间显示今天、昨天、前天
 */
export const formatBillDate = (timestamp : number) : string => {
	const date = new Date(timestamp * 1000)
	const now = new Date()

	// 获取当天 00:00:00 的秒级时间戳
	const getDateStart = (date : Date) : number => {
		const start = new Date(
			date.getFullYear(),
			date.getMonth(),
			date.getDate()
		)

		return Math.floor(start.getTime() / 1000)
	}

	// 都是秒级时间戳
	const today = getDateStart(now)
	const targetDay = getDateStart(date)

	const oneDay = 24 * 60 * 60

	const diffDay = Math.floor((today - targetDay) / oneDay)

	// 时分
	const hour = date.getHours()
	const minute = date.getMinutes()

	const hourText = hour < 10 ? `0${hour}` : `${hour}`
	const minuteText = minute < 10 ? `0${minute}` : `${minute}`

	const time = `${hourText}:${minuteText}`

	// 今天
	if (diffDay == 0) {
		return `今天 ${time}`
	}

	// 昨天
	if (diffDay == 1) {
		return `昨天 ${time}`
	}

	// 前天
	if (diffDay == 2) {
		return `前天 ${time}`
	}

	// 更早：年月日 时分
	const year = date.getFullYear()
	const month = date.getMonth() + 1
	const day = date.getDate()

	const monthText = month < 10 ? `0${month}` : `${month}`
	const dayText = day < 10 ? `0${day}` : `${day}`

	return `${year}-${monthText}-${dayText} ${time}`
}

// 根据传入的秒级时间戳计算时间 年月日
export const formatDateYearMonthDay = (timestamp : number) => {
	const date = new Date(timestamp * 1000)
	const year = date.getFullYear()
	const month = date.getMonth() + 1
	const day = date.getDate()
	return `${year}-${month}-${day}`
}
// 根据传入的秒级时间戳计算时间 年月日
export const formatDateYearMonthDayHourse = (timestamp : number) => {
	const date = new Date(timestamp * 1000)

	const year = date.getFullYear()
	const month = (date.getMonth() + 1).toString().padStart(2, '0')
	const day = date.getDate().toString().padStart(2, '0')
	const hour = date.getHours().toString().padStart(2, '0')
	const minute = date.getMinutes().toString().padStart(2, '0')

	return `${year}-${month}-${day} ${hour}:${minute}`
}

/**
 * 账单格式化成3个数字一个逗号，末尾两个0
 */
export const formatAmount = (amount : number) : string => {
	const fixed = amount.toFixed(2)
	const parts = fixed.split('.')

	parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',')

	return parts.join('.')
}

// 根据账单类型计算 当日收入/支出，或最近收入/支出
export const amountByTypeAndDateRange = (bills : Bill[], type : string, dateRange : 'today' | 'recent') => {
	const now = new Date()
	const curToday = now.getFullYear() + "-" + (now.getMonth() + 1) + "-" + now.getDate()
	if (dateRange == 'today') {
		return formatAmount(bills // 每三位数加逗号，和末尾两个零
			.filter(i => formatDateYearMonthDay(i.billDate as number) == curToday) // 筛选今日日期账单
			.filter(i => i.type == type) // 筛选 收入或支出
			.reduce((sum, bill) => sum + (bill.amount), 0)) // 当日累计收入/支出
	} else if (dateRange == 'recent') {
		return formatAmount(bills// 每三位数加逗号，和末尾两个零
			.filter(i => i.type == type) // 筛选 收入或支出
			.reduce((sum, bill) => sum + (bill.amount), 0)) // 最近累计收入/支出
	} else {
		return ""
	}

}
// 日期 + 时间转换成秒级时间戳
export const dateTimeToTimestamp = (
	dateStr : string,
	timeStr : string
) : number => {
	const dateParts = dateStr.split('-')
	const timeParts = timeStr.split(':')

	const year = parseInt(dateParts[0])
	const month = parseInt(dateParts[1])
	const day = parseInt(dateParts[2])

	const hour = parseInt(timeParts[0])
	const minute = parseInt(timeParts[1])

	// 使用 ISO 标准格式，并补齐月份和日期
	const monthStr = month < 10 ? '0' + month : '' + month
	const dayStr = day < 10 ? '0' + day : '' + day
	const timeStrFormat = hour < 10
		? '0' + hour + ':' + (minute < 10 ? '0' + minute : '' + minute)
		: '' + hour + ':' + (minute < 10 ? '0' + minute : '' + minute)

	const dateTimeStr = year + '-' + monthStr + '-' + dayStr + 'T' + timeStrFormat

	return Math.floor(new Date(dateTimeStr).getTime() / 1000)
}
