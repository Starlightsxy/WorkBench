import { LoginDTO } from "../../type"

const KEY = "login-storage"
// 缓存登录信息
export const setLoginStorage = (data : LoginDTO) => {
	uni.setStorageSync(KEY, data)
}
// 获取登录信息
export const getLoginStorage = () : LoginDTO | null => {
	return uni.getStorageSync(KEY) as LoginDTO | null
}

// 删除登录信息
export const removeLoginStorage = () => {
	uni.removeStorageSync(KEY)
}
