

// 用户的状态管理

import { UserInfoVO } from "../../type"


// key
const KEY = "user-storage"

// 存储用户信息
export const setUserStorage = (data : UserInfoVO) => {
	uni.setStorageSync(KEY, data)
}
// 存储用户信息
// export const getUserStorage = () : UserInfoVO => {
// 	return uni.getStorageSync(KEY) as UserInfoVO
// }

export const getUserStorage = () : UTSJSONObject | null => {
	const data = uni.getStorageSync(KEY)
	if (data == null) return null
	// 如果 data 是字符串，尝试解析为对象
	if (typeof data === 'string') {
		try {
			return JSON.parse(data) as UTSJSONObject
		} catch {
			return null
		}
	}
	// 如果已经是对象，直接返回（需要确保类型正确）
	return data as UTSJSONObject
}

// 删除用户信息
export const removeUserStorage = () => {
	uni.removeStorageSync(KEY)
}
