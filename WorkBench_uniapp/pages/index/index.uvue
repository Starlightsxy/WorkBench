	.todo-stats-wrapper {
		padding-left: 5px;
		box-sizing: border-box;
		flex-direction: column;
	}

	/* 四宫格布局 */
	.stats-grid-row {
		flex-direction: row;
		justify-content: space-between;
		margin-bottom: 15px;
	}

	.stats-column {
		flex-direction: column;
		align-items: flex-start;
		flex: 1;
	}

	.stats-label {
		font-size: 13px;
		color: #7b87a0;
		/* 适配您代码中的次要文字颜色 */
		margin-bottom: 4px;
	}

	.stats-number {
		font-size: 16px;
		font-weight: bold;
		color: #1a1a1a;
	}

	/* 特殊颜色状态 */
	.text-danger {
		color: #d32f2f;
	}

	.text-success {
		color: #0066ff;
	}

	/* 进度说明行 */
	.progress-label-row {
		flex-direction: row;
		justify-content: space-between;
		align-items: flex-end;
		margin-bottom: 6px;
	}

	.progress-text-hint {
		font-size: 13px;
		color: #7b87a0;
	}

	.progress-fraction-value {
		font-size: 15px;
		font-weight: bold;
		color: #0066ff;
	}


	.container {
		background-color: #f9f9ff;
		height: 100%;
		/* 或 100dvh */
		padding-top: var(--status-bar-height);
		/* 状态栏高度 */
		box-sizing: border-box;
		/* 确保 padding 包含在高度内 */

	}

	.navbar {
		justify-content: center;
		height: 8%;
		width: 100%;
		border-bottom: 1px #e0e3e5 solid;
		/* 底部内边距，可调整数值 */
		box-sizing: border-box;

	}

	.nvbar-img {
		width: 44px;
		height: 44px;
		padding: 3px;
		border-radius: 50%;

	}

	.txt-nvbar {
		justify-content: center;
	}

	.tasks,
	.anniversary {
		margin-left: 5%;
		margin-right: 5%;
		box-sizing: border-box;
		width: 90%;
		border: 1px #e0e3e5 solid;
		border-radius: 10px;
		padding-bottom: 10px;
		margin-top: 20px;
	}

	.tasks-item,
	.ann-item,
	{
	display: flex;
	flex-direction: row;
	align-items: center;
	}

	.bill {
		margin-left: 5%;
		margin-right: 5%;
		box-sizing: border-box;
		width: 90%;
		border: 1px #e0e3e5 solid;
		border-radius: 10px;
		margin-top: 20px;

	}

	.homeImg {
		width: 35px;
		height: 35px;
	}


	/* 账单模块内边距 */
	.bill-stats-wrapper {
		padding: 15px;
		flex-direction: column;
	}

	/* 标题行布局 */
	.bill-header-row {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 15px;
	}

	.bill-title-box {
		flex-direction: row;
		align-items: center;
	}

	.bill-icon-container {
		width: 36px;
		height: 36px;
		background-color: #d8e3fb;
		border-radius: 50%;
		justify-content: center;
		align-items: center;
	}

	.bill-main-icon {
		width: 24px;
		height: 24px;
	}

	.bill-title-text {
		font-size: 18px;
		font-weight: bold;
		color: #1a1a1a;
		margin-left: 10px;
	}

	.more-action-text {
		font-size: 13px;
		color: #0066ff;
		font-weight: 500;
	}

	/* 列表项布局 */
	.bill-list-content {
		flex-direction: column;
	}

	.bill-list-item {
		flex-direction: row;
		justify-content: space-between;
