<script setup lang="uts">
	import { getAnniversaryList } from '../../api/modules/Anniversary';
	import { getUserInfo } from '../../api/modules/User';
	import { getAccessTokenStorage, getRefreshTokenStorage, getUserStorage, refresh, refreshHandler, setAccessTokenStorage, setRefreshTokenStorage, setUserStorage } from '../../storage';
	import { ApiResponse, ApiResponseUTS, LoginUser, UserInfoVO } from '../../type';
	import { Anniversarys } from '../../type/module/anniversary';
	import { RequestError, get } from '../../utils/request';

	// 用户信息
	const userInfo = ref<UserInfoVO>({
		userName: '',
		nickName: '',
		avatar: '',
		email: '',
		phone: '',
		gender: '',
		birthday: 0,
		signature: '',
		theme: ''
	});

	// 获取时间
	const now = new Date();
	const dayStr = ['一', '二', '三', '四', '五', '六', '日'];

	const timeGreeting = computed(() => {
		const nowHourse = now.getHours();
		if (nowHourse >= 0 && nowHourse < 6) return "凌晨好：";
		if (nowHourse >= 6 && nowHourse < 11) return "早上好：";
		if (nowHourse >= 11 && nowHourse < 13) return "中午好：";
		if (nowHourse >= 13 && nowHourse < 18) return "下午好：";
		if (nowHourse >= 18 && nowHourse < 24) return "晚上好：";
		return "";
	});
	// 获取当前日期时间年月日周几
	const nowDay = computed(() => {
		return `${now.getFullYear()}年${now.getMonth() + 1}月${now.getDate()}日 周${dayStr[now.getDay() - 1]}`;
	});


	const getUser = async () => {

		// 第一次请求
		let response = await getUserInfo()
		if (!response) return
		const finalResult = await refreshHandler(response!, () => getUserInfo())

		if (finalResult) {
			if (finalResult?.data == null) return
			setUserStorage(finalResult.data)
			userInfo.value = finalResult.data
		}


	}

	// 任务进度条
	const pageList = ref([0, 25, 50, 75, 100]);
	// 后端返回过来所赋值的数据
	const annList = ref<UTSJSONObject[]>([]);
	// 随机展示的数据
	const annRandom = ref<UTSJSONObject>({
		title: '',
		anniversaryDate: 0,
		type: '',
		icon: '',
		remark: '',
		color: '',
		age: 0
	});

	/**
	 * 计算距离下一次生日还有多少天（输入秒级时间戳）
	 */
	function getDaysUntilNextBirthday(birthdayTimestampSeconds : number) : number {
		const birthMs = birthdayTimestampSeconds * 1000;
		const birth = new Date(birthMs);
		const month = birth.getMonth();
		const day = birth.getDate();
		const now = new Date();
		let nextBirthday = new Date(now.getFullYear(), month, day);
		if (nextBirthday.getTime() < now.getTime()) {
			nextBirthday = new Date(now.getFullYear() + 1, month, day);
		}
		const diffMs = nextBirthday.getTime() - now.getTime();
		const diffDays = Math.ceil(diffMs / (1000 * 60 * 60 * 24));
		return Math.max(0, diffDays);
	}

	// 计算下一次过生日时的年龄
	function getNextBirthdayAge(birthdayTimestampSeconds : number) : number {
		const days = getDaysUntilNextBirthday(birthdayTimestampSeconds);
		const birth = new Date(birthdayTimestampSeconds * 1000);
		const target = new Date(now.getTime() + days * 24 * 60 * 60 * 1000);
		return target.getFullYear() - birth.getFullYear();
	}

	// 根据剩余天数推算出对应的年月日
	const annRandomDate = computed(() : string => {
		const days = annRandom.value["anniversaryDate"] as number;
		if (days <= 0) return '';
		const target = new Date(now.getTime() + days * 24 * 60 * 60 * 1000);
		return `${target.getFullYear()}年${target.getMonth() + 1}月${target.getDate()}日`;
	});

	// 后端返回的是绝对路径，直接使用
	const annIconSrc = computed(() : string => {
		const icon = annRandom.value["icon"] as string;
		return icon;
	});

	const annTitleText = computed(() : string => {
		const title = annRandom.value["title"] as string;
		const age = annRandom.value["age"] as number;
		if (age > 0) return `距离 ${title} · ${age}岁生日`;
		return `距离 ${title}`;
	});

	const isAdultBirthday = computed(() : boolean => {
		return (annRandom.value["age"] as number) == 18;
	});

	const annTitleColor = computed(() : string => {
		const color = annRandom.value["color"] as string;
		if (color.length > 0) return color;
		return '#000000';
	});
	const annListLength = ref(0)
	// 刷新随机项
	function refreshRandom(idx : number) : void {
		const list = annList.value;
		if (list.length > 0) {
			annRandom.value = list[idx];
		}
	}

	// 获取纪念日
	const getAnniversary = async () => {
		// 初次请求获取纪念日
		let response = await getAnniversaryList()
		// 为空就return
		if (!response) return
		console.log("response：", response)
		// 处理可能需要刷新token的问题
		const finalResult = await refreshHandler(response!, () => getAnniversaryList())
		if (finalResult) {
			if (finalResult?.data == null) return
			// 后续数据处理
			const data = finalResult.data
			if (data && data.length > 0) {
				annList.value = data.map((item) => {
					let age = 0;
					const days = getDaysUntilNextBirthday(item.anniversaryDate)
					if (item.type == "生日") {
						age = getNextBirthdayAge(item.anniversaryDate)
					}
					return {
						...item,
						age: age,
						anniversaryDate: days
					}
				})
			}

		}

	}


	let timerId : number | null = null;



	onLoad(() => {

		getUser();
		getAnniversary();

		timerId = setInterval(() => {
			if (annList.value.length > 0) {
				if (annListLength.value == annList.value.length) {
					annListLength.value = 0
				}
				refreshRandom(annListLength.value);
				annListLength.value++
			}
		}, 2000);
	});

	onUnmounted(() => {
		const id = timerId;
		if (id !== null) {
			clearInterval(id);
			timerId = null;
		}
	});
</script>
<template>
	<view class="container">
		<!-- nav-bar -->
		<view class="navbar">
			<view class="flex-space-between">
				<view class="flex-space-between">
					<image class="nvbar-img" :src="userInfo.avatar" mode=""></image>
					<view class="pl-5 txt-nvbar">
						<text style="font-size: 20px; font-weight: bold;color: #004fcb;">WorkBench</text>
					</view>
				</view>
				<view>
					<image class="nvbar-img" src="/static/image/index/setting.png" mode=""></image>
				</view>
			</view>
		</view>
		<!-- welcome -->
		<scroll-view direction="vertical" style="height: 92%; padding-bottom:20px; ">
			<view class="mt-20 pl-10" style="box-sizing: border-box;">
				<view>
					<text class="fts-200" style="font-weight: bold;">
						<!-- {{timeGreeting}}{{userInfo?.nickName}} -->
					</text>
					<text class="fts-14">
						{{`今天是${nowDay}，让一切尽然有序。`}}
					</text>
				</view>
				<text style="font-size: 50px;">
					<!-- 当分钟是0-9区间时使用 String(now.getMinutes()).padStart(2, '0') 补0 -->
					{{now.getHours() + ":" + now.getMinutes().toString().padStart(2, '0')}}
				</text>
			</view>
			<!-- 今日待办 -->
			<view class="tasks" style="background-color: #ffffff;">
				<view style="margin: 10px;">
					<view class="tasks-item">
						<view
							style="background-color: #0066ff; border-radius: 50%;width: 40px;height: 40px; justify-content: center;align-items: center;">
							<image class="homeImg" src="/static/image/index/task_index.png"></image>
						</view>
						<text class='fts-20 pl-10'>今日待办</text>
					</view>
					<!-- 进度条 -->
					<view style="margin-top: 50px;">
						<!-- 带颜色和宽度的进度条 -->
						<view style="display: flex; flex-direction: row; align-items: center;">
							<text style="font-size: 24;">3</text>
							<text class="fts-12"
								style="margin-left: 4rpx; align-self: flex-end; color:#868787 ; margin-bottom: 6rpx;">/5已完成</text>
						</view>
						<progress :percent="pageList[1]" :stroke-width="6"
							style="border-radius: 3px; margin-top: 5px;" />

					</view>
				</view>

			</view>
			<!-- 倒数纪念日 -->
			<view class="anniversary" style="background-color: #d9e1fe;">
				<view class="flex-space-between" style="margin: 10px;">
					<view class="ann-item">
						<view
							style="background-color: #ffffff; border-radius: 50%; width: 40px;height: 40px; justify-content: center;align-items: center;">
							<image class="homeImg" src="/static/image/index/ann_index.png" mode=""></image>
						</view>
						<text class='fts-20 pl-10'>即将到来</text>
					</view>
					<view style=" box-sizing: border-box; padding:3px ;background-color: white;border-radius: 5px; ">
						<text class="fts-14">{{annRandom['type']}}</text>
					</view>
				</view>

				<view class="pl-20 pb-10" style=" box-sizing: border-box;">
					<view
						style="display: flex; flex-direction: row; align-items: center; justify-content: space-between;">
						<view style="flex: 1; margin-right: 10px; box-sizing: border-box;">
							<view style="">
								<text v-if="isAdultBirthday"
									style="color: #d81e06; font-weight: bold;">{{annTitleText}}</text>
								<text v-else :style="{ color: annTitleColor }">{{annTitleText}}</text>
							</view>
							<view style="display: flex;padding-left: -4px; flex-direction: row; align-items: center;">
								<text class="fts-12 mr-5" style="position: relative; top: 7rpx;">还有</text>
								<text style="font-size: 24;">{{annRandom["anniversaryDate"]}}</text>
								<text class="fts-12 ml-5" style="position: relative; top: 7rpx;">天</text>
							</view>
							<view v-if="annRandomDate.length > 0" style="margin-top: 4px;">
								<text class="fts-12" style="color: #4f7cff;">预计 {{annRandomDate}}</text>
							</view>
						</view>
						<image v-if="annIconSrc.length > 0" style="width: 56px; height: 56px;" :src="annIconSrc"
							mode="aspectFit"></image>
					</view>
				</view>
			</view>
			<!-- 最近账单 -->
			<view class="bill" style="background-color: #ffffff;">
				<view class="flex-space-between " style="margin: 10px;">
					<view class="bill-item">
						<view
							style="background-color: #d8e3fb; border-radius: 50%;width: 40px;height: 40px; justify-content: center;align-items: center;">
							<image class="homeImg" src="/static/image/index/bill_index.png" mode=""></image>
						</view>
						<text class='fts-20 pl-10'>最近账单</text>
					</view>
					<view style="">
						<text class="fts-14" style="color: blue; " @click="getUser()">查看全部</text>
					</view>
				</view>
				<!-- 账单列表 只统计最近10个 -->
				<view class=" bill-items flex-space-between" v-for="item in 10">
					<view class="bill-left">
						<view
							style="background-color: #d8e3fb;  border-radius: 5px; width: 30px;height:30px; justify-content: center;align-items: center;">
							<image style="width: 20px;height:20px; " src="/static/image/index/bill_index.png" mode="">
							</image>
						</view>
						<view class="ml-10">
							<text class="fts-16">山姆超市采购</text>
							<text class="fts-14">今天 10:30</text>
						</view>
					</view>
					<view style="box-sizing: border-box;">
						<text class="fts-14">-￥435.00</text>
					</view>
				</view>
				<!-- 总计 -->
				<view class="mb-10 flex-space-between">
					<view>
						<text class="fts-14  ml-5">
							当天消费：1200
						</text>
					</view>
					<view>
						<text class="fts-14  mr-5">
							最近消费：1200
						</text>
					</view>
				</view>
			</view>
		</scroll-view>


	</view>
</template>

<style scoped>
	.container {
		background-color: #f9f9ff;
		height: 100%;
		/* 或 100dvh */
		padding-top: var(--status-bar-height);
		/* 状态栏高度 */
		box-sizing: border-box;
		/* 确保 padding 包含在高度内 */

	}

	.navbar {
		justify-content: center;
		height: 8%;
		width: 100%;
		border-bottom: 1px #e0e3e5 solid;
		/* 底部内边距，可调整数值 */
		box-sizing: border-box;

	}

	.nvbar-img {
		width: 44px;
		height: 44px;
		padding: 3px;
		border-radius: 50%;

	}

	.txt-nvbar {
		justify-content: center;
	}

	.tasks,
	.anniversary {
		margin-left: 5%;
		margin-right: 5%;
		box-sizing: border-box;
		width: 90%;
		border: 1px #e0e3e5 solid;
		border-radius: 10px;
		padding-bottom: 10px;
		margin-top: 20px;
	}

	.tasks-item,
	.ann-item,
	.bill-item {
		display: flex;
		flex-direction: row;
		align-items: center;
		/* margin: 20px 0 0 20px; */
	}

	.bill {
		margin-left: 5%;
		margin-right: 5%;
		box-sizing: border-box;
		width: 90%;
		border: 1px #e0e3e5 solid;
		border-radius: 5px;
		margin-top: 20px;

	}

	.homeImg {
		width: 35px;
		height: 35px;

	}

	.bill-items {
		/* width: 100%; */
		margin-left: 10px;
		margin-right: 10px;
		/* padding: 10px; */
		padding: 10px 0 10px 0;
		box-sizing: border-box;
		border-bottom: 1px #d9e2fc solid;
		margin-bottom: 10px;
	}

	.bill-left {

		display: flex;
		flex-direction: row;
		align-items: center;
		box-sizing: border-box;
		/* border: 1px red solid; */
	}
</style>
