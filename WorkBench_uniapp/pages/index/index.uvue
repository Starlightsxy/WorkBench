		padding: 12px 0;
		border-bottom: 1px solid #f0f3ff;
	}

	.bill-list-item:last-child {
		border-bottom: none;
	}

	.item-left-side {
		flex-direction: row;
		align-items: center;
	}

	.item-type-icon-bg {
		width: 38px;
		height: 38px;
		background-color: #f5f7ff;
		border-radius: 10px;
		justify-content: center;
		align-items: center;
	}

	.item-type-icon {
		width: 20px;
		height: 20px;
	}

	.item-info-stack {
		flex-direction: column;
		margin-left: 12px;
	}

	.item-name-text {
		font-size: 15px;
		font-weight: 500;
		color: #1a1a1a;
		margin-bottom: 2px;
	}

	.item-time-text {
		font-size: 12px;
		color: #7b87a0;
	}

	.item-amount-text {
		font-size: 16px;
		font-weight: bold;
	}

	.text-expense {
		color: #DC2626;
	}

	.text-income {
		color: #16A34A;
	}

	/* 底部汇总布局 */
	.bill-footer-summary {
		flex-direction: row;
		background-color: #f8f9ff;
		border-radius: 12px;
		padding: 12px;
		margin-top: 10px;
		align-items: center;
	}

	.summary-col {
		flex: 1;
		flex-direction: column;
		align-items: center;
	}

	.summary-label {
		font-size: 11px;
		color: #7b87a0;
		margin-bottom: 2px;
	}

	.summary-value {
		font-size: 12px;
		font-weight: bold;
		color: #1a1a1a;
	}

	.summary-divider {
		width: 1px;
		height: 20px;
		background-color: #e0e6f0;
	}
</style>
