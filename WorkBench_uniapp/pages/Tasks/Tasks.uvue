	}


	/* 日期选择器 */
	.date-picker-trigger {
		height: 56px;
		background-color: #f5f7ff;
		border-radius: 12px;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 0 16px;
	}

	.date-left {
		flex-direction: row;
		align-items: center;
	}

	.icon-calendar {
		font-size: 18px;
		margin-right: 10px;
	}

	.date-placeholder {
		font-size: 15px;
		color: #666;
	}

	.icon-arrow {
		font-size: 14px;
		color: #999;
	}

	.action-area {
		margin-top: 12px;
		padding-bottom: 20px;
	}

	/* 任务列表 */
	/* 状态切换栏 */
	.tab-header {
		flex-direction: row;
		margin-bottom: 24px;
		border-bottom: 1px solid #f0f3ff;
	}

	.tab-item {
		padding: 12px 0;
		margin-right: 32px;
		position: relative;
		align-items: center;
		justify-content: center;
	}

	.tab-text {
		font-size: 16px;
		color: #7b87a0;
		font-weight: 500;
	}

	.active-text {
		color: #1a1a1a;
		font-weight: bold;
	}

	.active-line {
		position: absolute;
		bottom: 0;
		width: 20px;
		height: 3px;
		background-color: #0066ff;
		border-radius: 2px;
	}

	/* 添加任务入口 (虚线卡片) */
	.add-task-entry {
		flex-direction: row;
		align-items: center;
		padding: 18px;
		background-color: #f9faff;
