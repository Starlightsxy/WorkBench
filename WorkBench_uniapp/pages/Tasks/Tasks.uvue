	.add-icon-box {
		width: 24px;
		height: 24px;
		border-radius: 12px;
		align-items: center;
		justify-content: center;
		margin-right: 12px;
	}



	.add-placeholder-text {
		font-size: 15px;
		color: #7b87a0;
	}

	/* 任务列表 */
	.todo-list-container {
		flex-direction: column;
	}

	.todo-item {
		box-sizing: border-box;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding: 16px 0;
		border-bottom: 1px solid #f0f3ff;
	}

	.no-border {
		border-bottom: none;
	}

	.todo-content {
		flex-direction: column;
		flex: 1;
	}

	.todo-title {
		font-size: 16px;
		font-weight: 500;
		color: #1a1a1a;
		margin-bottom: 4px;
	}

	.todo-time {
		font-size: 13px;
		color: #7b87a0;
	}

	/* 优先级标签 */
	.priority-tag {
		padding: 4px 10px;
		border-radius: 6px;
		justify-content: center;
		align-items: center;
	}

	/* 已取消 */
	.tag-cancel {
		background-color: #eeeeee;
	}

	.text-cancel {
		color: #9e9e9e;
		font-size: 11px;
		font-weight: bold;
	}

	/* 高优先级 */
	.tag-high {
		background-color: #ffebeb;
	}

	.text-high {
		color: #d32f2f;
		font-size: 11px;
		font-weight: bold;
	}

	/* 中优先级 */
	.tag-mid {
		background-color: #eef2ff;
	}

	.text-mid {
		color: #0066ff;
		font-size: 11px;
		font-weight: bold;
	}

	/* 低优先级 */
	.tag-low {
		background-color: #f3f6fa;
	}

	.text-low {
		color: #7b87a0;
		font-size: 11px;
		font-weight: bold;
	}

	.delTask-item {
		height: 40px;
		padding: 0 5px;
		margin: 0 3px;
		justify-content: center;
	}

	/* 已完成样式 */
	.text-gray {
		color: #999;
	}

	.check-icon-box {
		width: 20px;
		height: 20px;
	}
</style>
