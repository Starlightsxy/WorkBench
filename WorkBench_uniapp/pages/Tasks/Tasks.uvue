<script setup lang="uts">
	import { getTaskList, saveTask } from '../../api';
	import { getUserStorage } from '../../storage';
	import { Task, saveTaskDTO, tasksStatus } from '../../type';
	import { dateTimeToTimestamp, formatBillDate, formatDateYearMonthDay, formatDateYearMonthDayHourse, getCurrentMinuteTimestamp } from '../../utils';



	const userInfo = getUserStorage()


	// 所有任务
	const tasks = ref<Task[]>([])

	// 待办任务：进行中
	const taskDoIng = computed(() => {
		return [...tasks.value].filter(item => item.status == "进行中")
	})
	// 已完成任务
	const completedTasks = computed(() => {
		return tasks.value.filter(item => item.status == "已完成")
	})
	// 已取消的任务
	const canceledTasks = computed(() => {
		return tasks.value.filter(item => item.status == "已取消")
	})
	// 获取任务待办
	const getTasks = async () => {
		const res = await getTaskList()
		if (!res || !res?.data) return
		tasks.value = res?.data
	}
	// 计算优先级
	// 计算优先级
	const proiorityStr = (task : Task) => {
		const now = new Date().getTime()
		const dueTime = task.dueTime * 1000

		// 剩余时间，单位：小时
		const remainingHours =
			(dueTime - now) / (1000 * 60 * 60)

		if (remainingHours <= 24) {
			return "高优先级"
		} else if (remainingHours <= 72) {
			return "中优先级"
		} else {
			return "低优先级"
		}
	}
	// 根据优先级动态绑定样式
	const priorityClass = (task : Task) => {
		const priority = proiorityStr(task)

		switch (priority) {
			case "高优先级":
				return "tag-high"
			case "中优先级":
				return "tag-mid"
			default:
				return "tag-low"
		}
	}

	const activeStyle = {
		color: 'white',
		backgroundColor: '#0050cb',
		fontWeight: 'bold'
	};


	// 添加任务的dto
	const tasksData = ref<saveTaskDTO>({
		id: 0,
		title: '',
		status: '',
		description: '', // 或 1, 2, 3 等
		dueTime: 0,        // 或 null, 或当前时间
		deleted: 0,
	});
	// 截至日期
	const startDay = ref('')
	// 截至时间
	const startTime = ref('')
	// 是否显示弹层组件
	const containerShow = ref(false)



	// 计算日期选择器的开始时间 和结束时间
	const startDateTime = computed(() => {
		const now = new Date();
		const year = now.getFullYear();
		return `${year}-01-01 00:00`;
	});
	const endDateTime = computed(() => {
		return `2030-12-31 23:59`
	})

	// 选中年月日的picker
	const onDateChange = (e : UniPickerChangeEvent) => {
		startDay.value = e.detail.value as string
	}
	// 选中时间的picker
	const onTimeChange = (e : UniPickerChangeEvent) => {
		startTime.value = e.detail.value as string
	}


	const closeContainer = async (type : 'save' | 'other') => {
		if (type == 'save') {
			// 新增或修改操作，也就是保存
			if (!tasksData.value.title) {
				uni.showToast({
					title: '标题不能为空',
					icon: 'error'
				})
				return
			}
			if (!tasksData.value.description) {
				uni.showToast({
					title: '内容不能为空',
					icon: 'error'
				})
				return
			}

			if (!startDay.value || !startTime.value) {
				uni.showToast({
					title: '截止时间必须填写',
					icon: 'error'
				})
				return
			}
			const sTime = getCurrentMinuteTimestamp();
			const endTime = dateTimeToTimestamp(startDay.value, startTime.value)
			const eightHours = 8 * 60 * 60
			const isValid = endTime - sTime > eightHours
			// 必须大于8小时
			if (!isValid) {
				uni.showToast({
					title: '截止时间大于当前8小时',
					icon: 'error'
				})
				return
			}
			tasksData.value.dueTime = dateTimeToTimestamp(startDay.value, startTime.value)
		}


		// 发送请求
		// 根据id不同发送不同请求
		const res = await saveTask(tasksData.value)
		if (res?.code == 1) {
			uni.showToast({
				title: res.message,
				icon: 'success'
			})
			containerShow.value = false
			// 关闭弹层
			await getTasks()
		}


	}

	const cancelTask = () => {
		uni.showModal({
			title: "取消任务",
			content: "确定要取消这个任务吗？",
			confirmText: "确定",
			cancelText: "取消",
			success: (res) => {
				if (res.confirm) {
					// 用户点击了删除
					tasksData.value.status = "已取消"
					closeContainer('other')
				}
			}
		})

	}
	const comTask = () => {
		tasksData.value.status = "已完成"
		closeContainer('other')


	}
	const delTask = () => {
		uni.showModal({
			title: "删除任务",
			content: "确定要删除这个任务吗？",
			confirmText: "删除",
			cancelText: "取消",
			success: (res) => {
				if (res.confirm) {
					// 用户点击了删除
					tasksData.value.deleted = 1
					closeContainer('other')
				}
			}
		})

	}
	// 点击遮罩层触发
	const clickOver = () => {
		containerShow.value = false
	}


	const currentTab = ref(0); // 0: 进行中, 1: 已完成 2:已取消
	const flag = ref('')
	const onAddTask = (type : "add" | "edit", task : Task | null) => {
		// 触发添加任务弹层逻辑
		containerShow.value = true
		if (type == 'add') {
			flag.value = '新增任务'
			// 清空表单
			tasksData.value = {
				id: 0,
				title: '',
				status: '',
				description: '',
				dueTime: 0,
				deleted: 0
			}
			startDay.value = ''
			startTime.value = ''
			return
		}

		if (type == 'edit') {
			flag.value = '修改任务'
			if (task == null) return
			tasksData.value.id = task.id
			tasksData.value.title = task.title
			tasksData.value.description = task.description
			tasksData.value.status = task.status
			tasksData.value.dueTime = task.dueTime

			// 给日期选择器年月日，赋值年月日
			startDay.value = formatDateYearMonthDay(tasksData.value.dueTime)

			// 给日期选择器时分，赋值时分
			const now = new Date(tasksData.value.dueTime * 1000)

			const hour = now.getHours().toString().padStart(2, '0')
			const minute = now.getMinutes().toString().padStart(2, '0')

			const time = `${hour}:${minute}`
			startTime.value = time


			return
		}
	};

	onShow(async () => {
		await getTasks()
	})
</script>
<template>
	<view class="container">
		<!-- nav-bar -->
		<view class="navbar">
			<view class="flex-space-between">
				<view class="flex-space-between">
					<image class="nvbar-img" :src="userInfo?.avatar" mode=""></image>
					<view class="pl-5 txt-nvbar">
						<text style="font-size: 20px; font-weight: bold;color: #004fcb;">待办事项</text>
					</view>
				</view>
				<view>
					<image class="nvbar-img" src="/static/image/index/setting.png" mode=""></image>
				</view>
			</view>
		</view>
		<!-- 任务列表 -->
		<scroll-view
			style="  height: 88%; box-sizing: border-box; width: 90%; margin-left: 5%; margin-right: 5%;margin-top: 20px;">

			<!-- 1. 状态切换 Tab (进行中 / 已完成) -->
			<view class="tab-header">
				<view class="tab-item" :class="{ 'active': currentTab == 0 }" @click="currentTab = 0">
					<text class="tab-text" :class="{ 'active-text': currentTab == 0 }">进行中</text>
					<view v-if="currentTab == 0" class="active-line"></view>
				</view>
				<view class="tab-item" :class="{ 'active': currentTab == 1 }" @click="currentTab = 1">
					<text class="tab-text" :class="{ 'active-text': currentTab == 1 }">已完成</text>
					<view v-if="currentTab == 1" class="active-line"></view>
				</view>
				<view class="tab-item" :class="{ 'active': currentTab == 2 }" @click="currentTab = 2">
					<text class="tab-text" :class="{ 'active-text': currentTab == 2 }">已取消</text>
					<view v-if="currentTab == 2" class="active-line"></view>
				</view>
			</view>

			<!-- 2. 添加新任务入口 (虚线边框卡片) -->
			<view v-if="currentTab == 0" class="add-task-entry" @click="onAddTask('add',null)">
				<view class="add-icon-box">
					<image src="/static/image/task/add.png" style="width: 20px;height:20px;" mode=""></image>
				</view>
				<text class="add-placeholder-text">添加新任务...</text>
			</view>

			<!-- 3. 任务列表容器 -->
			<view class="todo-list-container">
				<!-- 进行中列表 -->
				<view v-if="currentTab == 0" class="task-group">
					<view v-if="taskDoIng.length == 0" style="height: 100%; justify-content: center;align-items: center; padding-top:100px;">
						<image src="/static/image/task/空空如也 (1).png" mode=""></image>
					</view>
					<!-- 任务项: 高优先级 -->
					<view v-else v-for="item in taskDoIng " :key="item.id">
						<view class="todo-item" v-if="item.status=='进行中'">
							<view class="todo-content" @click="onAddTask('edit',item)">
								<text class="todo-title">{{item.title}}</text>
								<text class="todo-time">截止日期{{formatDateYearMonthDayHourse(item.dueTime)}}</text>
							</view>

							<view :class="['priority-tag', priorityClass(item)]">
								<text :class="[
									'tag-text',
									priorityClass(item).replace('tag-', 'text-')
								]">
									{{ proiorityStr(item) }}
								</text>
							</view>
							<view class="delTask-item" @click="cancelTask()">
								<image src="/static/image/task/cancel.png" style="width: 20px;height: 20px;" mode="">
								</image>
							</view>
							<view class="delTask-item" @click="delTask()">
								<image src="/static/image/task/delete.png" style="width: 20px;height: 20px;" mode="">
								</image>
							</view>
						</view>
					</view>
				</view>

				<!-- 已完成列表 -->
				<view v-if="currentTab == 1">
					<view v-if="completedTasks.length == 0" style="height: 100%; justify-content: center;align-items: center; padding-top:186px;">
						<image src="/static/image/task/空空如也 (1).png" mode=""></image>
					</view>
					<view v-else v-for="(item, index) in completedTasks" :key="index">
						<view class="todo-item completed-item">
							<view class="todo-content">
								<text class="todo-title text-gray">{{item.title}}</text>
								<text class="todo-time">完成时间-{{formatBillDate(item.completedTime as number)}}</text>
							</view>
							<view class="check-icon-box">
								<image style="width: 20px;height: 20px;" src="/static/image/task/completed.png" mode="">
								</image>
							</view>
							<view class="delTask-item" @click="delTask()">
								<image src="/static/image/task/delete.png" style="width: 20px;height: 20px;" mode="">
								</image>
							</view>
						</view>

					</view>

				</view>
				<!-- 已取消 -->
				<view v-if="currentTab == 2" class="task-group">
					<view v-if="canceledTasks.length == 0" style="height: 100%; justify-content: center;align-items: center; padding-top:186px;">
						<image src="/static/image/task/空空如也 (1).png" mode=""></image>
					</view>
					<view v-else v-for="item in canceledTasks">
						<view class="todo-item">
							<view class="todo-content" >
								<text class="todo-title text-gray">{{item.title}}</text>
								<text
									class="todo-time  text-gray">截止日期{{formatDateYearMonthDayHourse(item.dueTime)}}</text>
							</view>

							<view class="tag-cancel priority-tag">
								<text class="text-cancel">
									{{item.status}}
								</text>
							</view>
							<view class="delTask-item" @click="delTask()">
								<image src="/static/image/task/delete.png" style="width: 20px;height: 20px;" mode="">
								</image>
							</view>
						</view>
					</view>

				</view>
			</view>
		</scroll-view>
		<page-container :show="containerShow" @clickoverlay="clickOver" position="bottom" round overlay>
			<view class="modal-content">
				<!-- 顶部手柄 -->
				<view class="modal-handle"></view>

				<!-- 标题区域 -->
				<view class="modal-header">
					<text class="modal-title">{{flag}}</text>
				</view>

				<scroll-view class="modal-body" scroll-y="true">
					<!-- 任务标题 -->
					<view class="form-item">
						<text class="form-label">任务标题</text>
						<input class="form-input" v-model="tasksData.title" placeholder="请输入任务标题..."
							placeholder-style="color: #999;" />
					</view>

					<!-- 任务内容 -->
					<view class="form-item">
						<text class="form-label">任务内容</text>
						<textarea class="form-textarea" v-model="tasksData.description" placeholder="请输入任务详细内容..."
							placeholder-style="color: #999;"></textarea>
					</view>


					<!-- 截止日期 -->
					<view class="form-item">
						<text class="form-label">截止日期</text>


						<picker class="picker-time--test uni-picker-container-wrap" mode="date" :start="startDateTime "
							:end="endDateTime" @change="onDateChange">
							<view class="date-picker-trigger">
								<view class="date-left">
									<text class="icon-calendar">📅</text>
									<text class="date-placeholder">{{startDay?startDay:'选择截至日期'}}</text>
								</view>
								<text class="icon-arrow">></text>
							</view>
						</picker>
						<text>&nbsp;</text>
						<picker class="picker-time--test uni-picker-container-wrap" mode="time" @change="onTimeChange">
							<view class="date-picker-trigger">
								<view class="date-left">
									<text class="icon-calendar">📅</text>
									<text class="date-placeholder">{{startTime?startTime:'选择截至时间'}}</text>
								</view>
								<text class="icon-arrow">></text>
							</view>
						</picker>
					</view>

					<!-- 操作按钮 -->
					<view class="action-area">
						<button v-if="flag == '修改任务'" style="margin-top: 20px;" @click="comTask()" type="primary">完成任务</button>
						<button style="margin-top: 20px;" @click="closeContainer('save')"
							type="primary">{{flag}}</button>
					</view>

					<!-- 底部安全区域占位 -->
					<!-- <view class="safe-area-bottom"></view> -->
				</scroll-view>
			</view>
		</page-container>
	</view>
</template>



<style scoped>
	.container {
		background-color: #f9f9ff;
		height: 100%;
		/* 或 100dvh */
		padding-top: var(--status-bar-height);
		/* 状态栏高度 */
		box-sizing: border-box;
		/* 确保 padding 包含在高度内 */

	}

	.navbar {
		justify-content: center;
		height: 8%;
		width: 100%;
		border-bottom: 1px #e0e3e5 solid;
		/* 底部内边距，可调整数值 */
		box-sizing: border-box;

	}

	.nvbar-img {
		width: 44px;
		height: 44px;
		padding: 3px;
		border-radius: 50%;

	}

	.txt-nvbar {
		justify-content: center;
	}


	.modal-content {
		background-color: #ffffff;
		border-top-left-radius: 24px;
		border-top-right-radius: 24px;
		flex-direction: column;
		/* max-height: 85%; */
	}

	.modal-handle {
		width: 40px;
		height: 5px;
		background-color: #e0e0e0;
		border-radius: 10px;
		align-self: center;
		margin-top: 12px;
	}

	.modal-header {
		padding: 20px 0;
		align-items: center;
	}

	.modal-title {
		font-size: 18px;
		font-weight: 800;
		color: #1a1a1a;
	}

	.modal-body {
		padding: 0 20px;
		flex: 1;
	}

	.form-item {
		margin-bottom: 24px;
	}

	.form-label {
		font-size: 14px;
		color: #666;
		font-weight: 500;
		margin-bottom: 12px;
		/* display: block; */
	}

	.form-input {
		height: 52px;
		background-color: #ffffff;
		border: 1px solid #e0e6f0;
		border-radius: 12px;
		padding: 0 16px;
		font-size: 15px;
		color: #1a1a1a;
	}

	.form-textarea {
		height: 100px;
		background-color: #ffffff;
		border: 1px solid #e0e6f0;
		border-radius: 12px;
		padding: 12px 16px;
		font-size: 15px;
		color: #1a1a1a;
