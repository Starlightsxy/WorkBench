<script setup lang="uts">
import { getUserStorage } from '../../storage';



	const userInfo = getUserStorage()

	type tasksStatus = {
		index : number;
		name : string;
		css : string;
		level:string;
	}

	const taskStatus = reactive<tasksStatus[]>([
		{
			index: 0,
			name: '进行中',
			css: 'level-1',
			level:'高优先级'
		},
		{
			index: 1,
			name: '已完成',
			css: 'level-2',
			level:'中优先级'
		},
		{
			index: 2,
			name: '已取消',
			css: 'level-3',
			level:'低优先级'
		}
	])
	const activeIndex = ref(0)

	const changeSel = (val : number){
		activeIndex.value = val
		// 根据状态查询对应的任务
	}

	const activeStyle = {
		color: 'white',
		backgroundColor: '#0050cb',
		fontWeight: 'bold'
	};
	type addTaskDTO = {
		title : string;// 标题
		description : string;// 描述
		priority : string;// 优先级
		dueTime : number;// 截至时间
	}

	// 添加任务的dto
	const tasksData = ref<addTaskDTO>({
		title: '',
		description: '',
		priority: '1',   // 或 1, 2, 3 等
		dueTime: 0         // 或 null, 或当前时间
	});
	// 截至日期
	const startDay = ref('')
	// 截至时间
	const startTime = ref('')
	// 是否显示弹层组件
	const containerShow = ref(false)

	// 编辑任务
	const editTasks = () => {
		// 点击编辑触发弹层
		containerShow.value = true;
	}
	// 优先级单选框触发
	// 监听 radio-group 的变化
	const onPriorityChange = (event : UniRadioGroupChangeEvent) => {
		tasksData.value.priority = (event.detail.value)
	};
	// 计算日期选择器的开始时间 和结束时间
	const startDateTime = computed(() => {
		const now = new Date();
		const year = now.getFullYear();
		return `${year}-01-01 00:00`;
	});
	const endDateTime = computed(() => {
		return `2030-12-31 23:59`
	})

	// 选中年月日的picker
	const onDateChange = (e : UniPickerChangeEvent) => {
		startDay.value = e.detail.value as string
	}
	// 选中时间的picker
	const onTimeChange = (e : UniPickerChangeEvent) => {
		startTime.value = e.detail.value as string
	}
	// 进入弹层后触发
	const onAfterLeave = () => {
		console.log('进来了')
	}
	const closeContainer = () => {
		// 判断是否有数据
		if (!tasksData.value.title) {
			uni.showToast({
				title: '标题不能为空',
				icon: 'error'
			})
			return
		}
		if (!tasksData.value.description) {
			uni.showToast({
				title: '内容不能为空',
				icon: 'error'
			})
			return
		}
		if (!tasksData.value.priority) {
			uni.showToast({
				title: '级别必须填写',
				icon: 'error'
			})
			return
		}
		if (!startDay.value || !startTime.value) {
			uni.showToast({
				title: '截止时间必须填写',
				icon: 'error'
			})
			return
		}

		// 截止时间转换成时间戳格式
		let data = startDay.value + 'T' + startTime.value
		tasksData.value.dueTime = new Date(data).getTime() / 1000
		console.log(tasksData.value)

		// 发送请求

		// 清空表单
		tasksData.value = {
			title: '',
			description: '',
			priority: '1',   // 或 1, 2, 3 等
			dueTime: 0
		}
		// 关闭弹层
		containerShow.value = false
	}
	// 点击遮罩层触发
	const clickOver = () => {
		containerShow.value = false
	}
</script>
<template>
	<view class="container">
		<!-- nav-bar -->
		<view class="navbar">
			<view class="flex-space-between">
				<view class="flex-space-between">
					<image class="nvbar-img" :src="userInfo?.avatar" mode=""></image>
					<view class="pl-5 txt-nvbar">
						<text style="font-size: 20px; font-weight: bold;color: #004fcb;">待办事项</text>
					</view>
				</view>
				<view>
					<image class="nvbar-img" src="/static/image/index/setting.png" mode=""></image>
				</view>
			</view>
		</view>
		<!-- 任务列表 -->
		<scroll-view
			style="  height: 88%; box-sizing: border-box; width: 90%; margin-left: 5%; margin-right: 5%;margin-top: 20px;">
			<!-- 任务选项 -->
			<view
				style=" border-bottom:1px #e0e3e5 solid; display: flex;flex-direction: row; align-items: center; height: 7%;box-sizing: border-box;">
				<text @click="changeSel(item.index)" v-for="(item) in taskStatus" class="mr-15 task-sel fts-12"
					:key="item.index" :style="activeIndex == item.index ? activeStyle : ''">
					{{item.name}}
				</text>
			</view>
			<view v-for="it in taskStatus">
				<view v-if="activeIndex == it.index">
					<!-- 任务列表 -->
					<view v-for="item in 50" class="flex-space-between tasks-item" @click="editTasks">
						<view>
							<text class="fts-16">完成季度财务报表</text>
							<text class="fts-12" style="color: #7b87a0;">2026-1-4 15:30 - 2026-2-4 15:30</text>
						</view>
						<view class="tasks-item-right">
							<text class="fts-12 level" :class="it.css">{{it.level}}</text>
						</view>
					</view>
				</view>
			</view>

		</scroll-view>
		<page-container :show="containerShow" @clickoverlay="clickOver" position="bottom" round overlay
			@afterenter="onAfterLeave">
			<view class="modal-content">
				<!-- 顶部手柄 -->
				<view class="modal-handle"></view>

				<!-- 标题区域 -->
				<view class="modal-header">
					<text class="modal-title">新建任务</text>
				</view>

				<scroll-view class="modal-body" scroll-y="true">
					<!-- 任务标题 -->
					<view class="form-item">
						<text class="form-label">任务标题</text>
						<input class="form-input" v-model="tasksData.title" placeholder="请输入任务标题..."
							placeholder-style="color: #999;" />
					</view>

					<!-- 任务内容 -->
					<view class="form-item">
						<text class="form-label">任务内容</text>
						<textarea class="form-textarea" v-model="tasksData.description" placeholder="请输入任务详细内容..."
							placeholder-style="color: #999;"></textarea>
					</view>

					<!-- 优先级选择 (Radio Group 深度定制版) -->
					<view class="form-item">
						<text class="form-label">优先级</text>
						<radio-group class="priority-radio-group" @change="onPriorityChange">
							<!-- 低优先级 -->
							<view class="priority-label low" @click="tasksData.priority = '1'"
								:class="{ active_low: tasksData.priority === '1' }">
								<view class="radio-box">
									<radio value="1" :checked="tasksData.priority === '1'" color=" #757575"
										style="transform:scale(0.8)" />
								</view>
								<text class="priority-text text-low">低</text>
							</view>

							<!-- 中优先级 (默认选中) -->
							<view class="priority-label mid " @click="tasksData.priority = '2'"
								:class="{ active_mid: tasksData.priority === '2' }">
								<view class="radio-box">
									<radio value="2" :checked="tasksData.priority === '2'" color=" #0066ff"
										style="transform:scale(0.8)" />
								</view>
								<text class="priority-text text-mid">中</text>
							</view>

							<!-- 高优先级 -->
							<view class="priority-label high" @click="tasksData.priority = '3'"
								:class="{ active_high: tasksData.priority === '3' }">
								<view class="radio-box">
									<radio value="3" :checked="tasksData.priority === '3'" color=" #d32f2f"
										style="transform:scale(0.8)" />
								</view>
								<text class="priority-text text-high">高</text>
							</view>
						</radio-group>
					</view>

					<!-- 截止日期 -->
					<view class="form-item">
						<text class="form-label">截止日期</text>


						<picker class="picker-time--test uni-picker-container-wrap" mode="date" :start="startDateTime "
							:end="endDateTime" @change="onDateChange">
							<view class="date-picker-trigger">
								<view class="date-left">
									<text class="icon-calendar">📅</text>
									<text class="date-placeholder">{{startDay?startDay:'选择截至日期'}}</text>
								</view>
								<text class="icon-arrow">></text>
							</view>
						</picker>
						<text>&nbsp;</text>
						<picker class="picker-time--test uni-picker-container-wrap" mode="time" @change="onTimeChange">
							<view class="date-picker-trigger">
								<view class="date-left">
									<text class="icon-calendar">📅</text>
									<text class="date-placeholder">{{startTime?startTime:'选择截至时间'}}</text>
								</view>
								<text class="icon-arrow">></text>
							</view>
						</picker>
					</view>

					<!-- 操作按钮 -->
					<view class="action-area">
						<button style="margin-top: 20px;" @click="closeContainer" type="primary">添加任务</button>
					</view>

					<!-- 底部安全区域占位 -->
					<!-- <view class="safe-area-bottom"></view> -->
				</scroll-view>
			</view>
		</page-container>
	</view>
</template>



<style scoped>
	.level-1 {
		background-color: #FFEBEB;
		color: #D32F2F;
	}

	.level-2 {
		background-color: #E3F2FD;
		color: #1976D2;
	}

	.level-3 {

		background-color: #F5F5F5;
		color: #757575;
	}

	.level {
		box-sizing: border-box;
		padding: 3px 8px;
		border-radius: 50%;
	}

	.tasks-item {
		border-bottom: 1px #e0e3e5 solid;
		box-sizing: border-box;
		padding: 10px;
	}

	.tasks-item-right {
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.container {
		background-color: #f9f9ff;
		height: 100%;
		/* 或 100dvh */
		padding-top: var(--status-bar-height);
		/* 状态栏高度 */
		box-sizing: border-box;
		/* 确保 padding 包含在高度内 */

	}

	.navbar {
		justify-content: center;
		height: 8%;
		width: 100%;
		border-bottom: 1px #e0e3e5 solid;
		/* 底部内边距，可调整数值 */
		box-sizing: border-box;

	}

	.nvbar-img {
		width: 44px;
		height: 44px;
		padding: 3px;
		border-radius: 50%;

	}

	.txt-nvbar {
		justify-content: center;
	}

	.task-sel {
		padding: 5 10 5 10;
		border-radius: 50%;
	}

	.modal-content {
		background-color: #ffffff;
		border-top-left-radius: 24px;
		border-top-right-radius: 24px;
		flex-direction: column;
		/* max-height: 85%; */
	}

	.modal-handle {
		width: 40px;
		height: 5px;
		background-color: #e0e0e0;
		border-radius: 10px;
		align-self: center;
		margin-top: 12px;
	}

	.modal-header {
		padding: 20px 0;
		align-items: center;
	}

	.modal-title {
		font-size: 18px;
		font-weight: 800;
		color: #1a1a1a;
	}

	.modal-body {
		padding: 0 20px;
		flex: 1;
	}

	.form-item {
		margin-bottom: 24px;
	}

	.form-label {
		font-size: 14px;
		color: #666;
		font-weight: 500;
		margin-bottom: 12px;
		/* display: block; */
	}

	.form-input {
		height: 52px;
		background-color: #ffffff;
		border: 1px solid #e0e6f0;
		border-radius: 12px;
		padding: 0 16px;
		font-size: 15px;
		color: #1a1a1a;
	}

	.form-textarea {
		height: 100px;
		background-color: #ffffff;
		border: 1px solid #e0e6f0;
		border-radius: 12px;
		padding: 12px 16px;
		font-size: 15px;
		color: #1a1a1a;
		width: 100%;
	}

	/* Radio Group 核心样式对齐 */
	.priority-radio-group {
		flex-direction: row;
		justify-content: space-between;
	}

	.priority-label {
		flex: 1;
		height: 54px;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		border-radius: 12px;
		margin: 0 6px;
		transition: all 0.2s;
	}

	.priority-label:first-child {
		margin-left: 0;
	}

	.priority-label:last-child {
		margin-right: 0;
	}

	.radio-box {
		margin-right: 4px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.priority-text {
		font-size: 15px;
		font-weight: 600;
	}

	/* 优先级状态色 - 未选中状态 */
	.low {
		background-color: #f5f5f5;
	}

	.mid {
		background-color: #f5f5f5;
	}

	.high {
		background-color: #f5f5f5;
	}

	/* 优先级状态色 - 激活状态 (您可以根据逻辑动态绑定这些类名) */
	.active_low {
		background-color: #f5f5f5;
		border: 1px solid #757575;
	}

	.active_mid {
		background-color: #eef2ff;
		border: 1px solid #0066ff;
	}

	.active_high {
		background-color: #ffebeb;
		border: 1px solid #d32f2f;
	}

	.text-low {
		color: #757575;
	}

	.text-mid {
		color: #0066ff;
	}

	.text-high {
		color: #d32f2f;
	}

	/* 日期选择器 */
	.date-picker-trigger {
		height: 56px;
		background-color: #f5f7ff;
		border-radius: 12px;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 0 16px;
