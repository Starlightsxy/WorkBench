<script setup lang="uts">
	import { getBillOverview } from '../../api';
	import { getUserStorage } from '../../storage';
	import { BillGroup, BillPageVO } from '../../type';
	import { formatAmount, formatBillDate, formatDateYearMonthDay } from '../../utils';


	const userInfo = getUserStorage()


	// 账单页
	const billPageVO = ref<BillPageVO | null>(null)
	// 获取账单
	const getBillPage = async () => {
		const res = await getBillOverview()
		if (!res || !res?.data) return
		billPageVO.value = res?.data
	}

	// 账单分组
	const billGroups = computed<BillGroup[]>(() => {
		const groups : BillGroup[] = []
		// if (billPageVO.value?.records == null) return
		if (billPageVO.value) {
			for (const item of billPageVO.value.records) {
				const date = formatBillDate(item.billDate as number)

				let group = groups.find(i => i.date == (date as string))

				if (group) {
					group?.bills.push(item)
				} else {
					groups.push({
						date: date,
						bills: [item]
					})
				}
			}
		}


		return groups
	})
	onShow(() => {
		getBillPage()
	})
	onHide(() => {

	})
</script>

<template>
	<view class="container">
		<!-- nav-bar -->
		<view class="navbar">
			<view class="flex-space-between">
				<view class="flex-space-between">
					<image class="nvbar-img" :src="userInfo?.avatar" mode=""></image>
					<view class="pl-5 txt-nvbar">
						<text style="font-size: 20px; font-weight: bold;color: #004fcb;">我的账单</text>
					</view>
				</view>
				<view>
					<image class="nvbar-img" src="/static/image/index/setting.png" mode=""></image>
				</view>
			</view>
		</view>
		<scroll-view direction="vertical" style="height: 92%; padding-bottom:20px; ">
			<!-- 1. 总资产概览卡片 -->
			<view class="card summary-card">
				<text class="summary-label">总资产 (CNY)</text>
				<text class="total-amount">¥{{formatAmount(billPageVO?.totalAsset as number)}}</text>

				<view class="budget-row">
					<view class="budget-col">
						<text class="b-label">本月支出</text>
						<text
							class="b-value text-red">¥{{formatAmount(billPageVO?.month.billExpIncDTO.expense as number)}}</text>
					</view>
					<view class="budget-col">
						<text class="b-label">本月预算</text>
						<text class="b-value">¥{{formatAmount(billPageVO?.month.billPlanDTO.budget as number)}}</text>
					</view>
				</view>

				<!-- 预算进度条 -->
				<view class="budget-track">
					<view class="budget-fill" style="width: 54%;"></view>
				</view>
				<text class="budget-hint">已用 54%</text>
			</view>

			<!-- 2. 日期分组：今天 -->
			<view v-for="(item ,index) in billGroups" :key="index">
				<text class="date-header">{{item.date}}</text>
				<view class="card bill-list-card">
					<!-- 账单项：午餐 -->
					<view class="bill-item" v-for="i in item.bills">
						<view class="item-left">
							<view class="item-icon-bg">
								<image class="item-icon" :src="i.categoryIcon" mode="aspectFit">
								</image>
							</view>
							<view class="item-info">
								<text class="item-name">{{i.categoryName}}</text>
								<text class="item-desc">{{i.remark}} · {{i.accountName}}</text>
							</view>
						</view>
						<text class="item-amount" :class="i.type == '收入' ? 'text-income' : 'text-expense'">
							{{ i.type == "收入" ? "+" : "-" }}￥{{ formatAmount(i.amount) }}
						</text>
					</view>

				</view>
			</view>

		</scroll-view>
	</view>
</template>



