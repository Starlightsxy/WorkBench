<script setup lang="uts">
	import { getBillOverview } from '../../api';
	import { getUserStorage } from '../../storage';
	import { BillGroup, BillPageVO, YearMonthBillVO } from '../../type';
	import { formatAmount, formatBillDate, formatDateYearMonthDay } from '../../utils';


	const userInfo = getUserStorage()


	// 账单页
	const billPageVO = ref<BillPageVO | null>(null)


	// 获取账单
	const getBillPage = async () => {
		const res = await getBillOverview()
		if (!res || !res?.data) return
		billPageVO.value = res?.data
	}

	// 账单分组
	const billGroups = computed<BillGroup[]>(() => {
		const groups : BillGroup[] = []
		// if (billPageVO.value?.records == null) return
		if (billPageVO.value) {
			for (const item of billPageVO.value.records) {
				const date = formatBillDate(item.billDate as number)

				let group = groups.find(i => i.date == (date as string))

				if (group) {
					group?.bills.push(item)
				} else {
					groups.push({
						date: date,
						bills: [item]
					})
				}
			}
		}


		return groups
	})

	const yearBill = ref<YearMonthBillVO>({
		targetIncome: 0,
		actualIncome: 0,
		expenseBudget: 0,
		actualExpense: 0,
	})
	const monthBill = ref<YearMonthBillVO>({
		targetIncome: 0,
		actualIncome: 0,
		expenseBudget: 0,
		actualExpense: 0,
	})
	const calcYearMonthBill = (type : 'year' | 'month') => {
		if (billPageVO.value != null) {
			if (type == 'year') {
				yearBill.value.targetIncome = billPageVO.value.year.billPlanDTO.incomeGoal
				yearBill.value.actualIncome = billPageVO.value.year.billExpIncDTO.income
				yearBill.value.expenseBudget = billPageVO.value.year.billPlanDTO.budget
				yearBill.value.actualExpense = billPageVO.value.year.billExpIncDTO.expense
			} else if (type == 'month') {
				monthBill.value.targetIncome = billPageVO.value.month.billPlanDTO.incomeGoal
				monthBill.value.actualIncome = billPageVO.value.month.billExpIncDTO.income
				monthBill.value.expenseBudget = billPageVO.value.month.billPlanDTO.budget
				monthBill.value.actualExpense = billPageVO.value.month.billExpIncDTO.expense
			} else {
				console.log('')
			}
		}


	}

	// 月收入百分比
	const monthIncomePercentage = computed(() => {
		if (monthBill.value.targetIncome <= 0) {
			return 0
		}


		return (monthBill.value.actualIncome / monthBill.value.targetIncome) * 100
	})
	// 月支出百分比
	const monthExpensePercentage = computed(() => {
		if (monthBill.value.expenseBudget <= 0) {
			return 0
		}

		return (monthBill.value.actualExpense / monthBill.value.expenseBudget) * 100
	})
	// 年收入百分比
	const yeaerIncomePercentage = computed(() => {
		if (yearBill.value.targetIncome <= 0) {
			return 0
		}


		return (yearBill.value.actualIncome / yearBill.value.targetIncome) * 100
	})
	// 年支出百分比
	const yearExpensePercentage = computed(() => {
		if (yearBill.value.expenseBudget <= 0) {
			return 0
		}

		return (yearBill.value.actualExpense / yearBill.value.expenseBudget) * 100
	})

	// 百分比
	const progress = ref<number[]>([])
	const loadProgress = () => {
		for (var i = 0; i <= 100; i++) {
			progress.value.push(i)
		}
	}
	const addBill = () => {
		console.log("添加账单")
	}
	onShow(async () => {
		await getBillPage()
		loadProgress()
		calcYearMonthBill('year')
		calcYearMonthBill('month')
	})
	onHide(() => {

	})
</script>

<template>
	<view class="container">
		<!-- nav-bar -->
		<view class="navbar">
			<view class="flex-space-between">
				<view class="flex-space-between">
					<image class="nvbar-img" :src="userInfo?.avatar" mode=""></image>
					<view class="pl-5 txt-nvbar">
						<text style="font-size: 20px; font-weight: bold;color: #004fcb;">我的账单</text>
					</view>
				</view>
				<view>
					<image class="nvbar-img" src="/static/image/index/setting.png" mode=""></image>
				</view>
			</view>
		</view>
		<scroll-view direction="vertical" style="height: 92%; padding-bottom:20px; position:relative;">
			<!-- 添加账单按钮 -->

			<image @click="addBill()" src="/static/image/bill/addBill.png" class="add-bill" mode=""></image>
			<!-- 1. 总资产核心卡片 -->
			<view class="summary-card">
				<view class="total-assets-box">
					<text class="assets-label">总资产 (CNY)</text>
					<text class="assets-value"
						v-if="billPageVO">¥{{formatAmount(billPageVO?.totalAsset as number)}}</text>
				</view>

				<view class="divider"></view>

				<!-- 本月概览模块 -->
				<view class="overview-section">
					<view class="section-header">
						<text class="section-title">本月概览</text>
						<text class="section-subtitle">{{new Date().getMonth() + 1}}月收支</text>
					</view>
					<view class="stats-row">
						<view class="stats-col">
							<text class="s-label">本月预算</text>
							<text class="s-value text-blue">¥{{formatAmount(monthBill.expenseBudget as number)}}</text>
						</view>
						<view class="stats-col">
							<text class="s-label">支出</text>
							<text class="s-value text-red">¥{{formatAmount(monthBill.actualExpense as number)}}</text>
						</view>

						<view class="stats-col">
							<text class="s-label">收入目标</text>
							<text class="s-value text-blue">¥{{formatAmount(monthBill.targetIncome as number)}}</text>
						</view>
						<view class="stats-col">
							<text class="s-label">收入</text>
							<text class="s-value text-red">¥{{formatAmount(monthBill.actualIncome)}}</text>
						</view>
					</view>
					<view class="progress-container">
						<view class="progress-label-row">
							<text class="p-label">支出预算</text>
							<text class="p-percent">{{monthExpensePercentage.toFixed(2)}}%</text>
						</view>
						<progress v-if="monthExpensePercentage" backgroundColor="#f0f3ff" :border-radius="4"
							:activeColor="Math.round(monthExpensePercentage)>=100?'#67c23a':'#409eff'"
							:percent="progress[progress[Math.round(monthExpensePercentage)>=100?100:Math.round(monthExpensePercentage)]]"
							:stroke-width="8" />
						<view class="progress-label-row" style="margin-top: 5px;">

							<view style="display: flex;flex-direction: row; justify-content: center; align-items: center;">
								<text class="p-label">收入目标</text>
								·
								<text v-if="Math.round(monthIncomePercentage)>=100" class=" fts-12 text-red">
									已达成目标
								</text>
							</view>

							<text class="p-percent">{{monthIncomePercentage.toFixed(2)}}%</text>
						</view>
						<progress v-if="monthIncomePercentage" backgroundColor="#f0f3ff" :border-radius="4"
							:activeColor="Math.round(monthIncomePercentage)>=100?'#67c23a':'#409eff'"
							:percent="progress[Math.round(monthIncomePercentage)>=100?100:Math.round(monthIncomePercentage)]"
							:stroke-width="8" />
					</view>

				</view>

				<!-- 年度概览模块 -->
				<view class="overview-section no-margin">
					<view class="section-header">
						<text class="section-title">年度概览</text>
						<text class="section-subtitle">{{new Date().getFullYear()}}年度收支</text>
					</view>
					<view class="stats-row" v-if="billPageVO">
						<view class="stats-col">
							<text class="s-label">本年预算</text>
							<text
								class="s-value text-blue">¥{{formatAmount(billPageVO?.year.billPlanDTO.budget as number)}}</text>
						</view>
						<view class="stats-col">
							<text class="s-label">支出</text>
							<text
								class="s-value text-red">¥{{formatAmount(billPageVO?.year.billExpIncDTO.expense as number)}}</text>
						</view>
						<view class="stats-col">
							<text class="s-label">收入目标</text>
							<text
								class="s-value text-blue">¥{{formatAmount(billPageVO?.year.billPlanDTO.incomeGoal as number)}}</text>
						</view>
						<view class="stats-col">
							<text class="s-label">收入</text>
							<text
								class="s-value text-red">¥{{formatAmount(billPageVO?.year.billExpIncDTO.income as number)}}</text>
						</view>
					</view>
					<view class="progress-container">
						<view class="progress-label-row">
							<text class="p-label">支出预算</text>
							<text class="p-percent">{{yearExpensePercentage.toFixed(2)}}%</text>
						</view>
						<progress v-if="yearExpensePercentage" backgroundColor="#f0f3ff" :border-radius="4"
							:activeColor="Math.round(yearExpensePercentage)>=100?'#67c23a':'#409eff'"
							:percent="progress[progress[Math.round(yearExpensePercentage)>=100?100:Math.round(yearExpensePercentage)]]"
							:stroke-width="8" />
						<view class="progress-label-row" style="margin-top: 5px;">
							<view style="display: flex;flex-direction: row; justify-content: center; align-items: center;">
								<text class="p-label">收入目标</text>
								·
								<text v-if="Math.round(yeaerIncomePercentage)>=100" class=" fts-12 text-red">
									已达成目标
								</text>
							</view>
							<text class="p-percent">{{yeaerIncomePercentage.toFixed(2)}}%</text>
						</view>
						<progress v-if="yeaerIncomePercentage" backgroundColor="#f0f3ff"
							:activeColor="Math.round(yeaerIncomePercentage)>=100?'#67c23a':'#409eff'" :border-radius="4"
							:percent="progress[Math.round(yeaerIncomePercentage)>=100?100:Math.round(yeaerIncomePercentage)]"
							:stroke-width="8" />
					</view>
				</view>
			</view>

			<!-- 2. 日期分组：今天 -->
			<view v-for="(item ,index) in billGroups" :key="index">
				<text class="date-header">{{item.date}}</text>
				<view class="card bill-list-card">
					<!-- 账单项：午餐 -->
					<view class="bill-item" v-for="i in item.bills">
						<view class="item-left">
							<view class="item-icon-bg">
								<image class="item-icon" :src="i.categoryIcon" mode="aspectFit">
								</image>
							</view>
							<view class="item-info">
								<text class="item-name">{{i.categoryName}}</text>
								<text class="item-desc">{{i.remark}} · {{i.accountName}}</text>
							</view>
						</view>
						<text class="item-amount" :class="i.type == '收入' ? 'text-income' : 'text-expense'">
							{{ i.type == "收入" ? "+" : "-" }}￥{{ formatAmount(i.amount) }}
						</text>
					</view>

				</view>
			</view>

		</scroll-view>
	</view>
</template>



<style scoped>
	.add-bill {
		position: fixed;
		bottom: 20;
		right: 20px;
		width: 60px;
		height: 60px;
	}

	.container {
		background-color: #f9f9ff;
		height: 100%;
		/* 或 100dvh */
		padding-top: var(--status-bar-height);
		/* 状态栏高度 */
		box-sizing: border-box;
		/* 确保 padding 包含在高度内 */

	}

	.navbar {
		justify-content: center;
		height: 8%;
		width: 100%;
		border-bottom: 1px #e0e3e5 solid;
		/* 底部内边距，可调整数值 */
		box-sizing: border-box;

	}

	.nvbar-img {
		width: 44px;
		height: 44px;
		padding: 3px;
		border-radius: 50%;

	}

	.txt-nvbar {
		justify-content: center;
	}




	/* 通用卡片样式 */
	.card {
		background-color: #ffffff;
		border-radius: 20px;
		padding: 20px;
		margin: 0 16px 16px;
	}

	/* 资产概览卡片 */
	/* 总资产大卡片 */
	.summary-card {
		background-color: #ffffff;
		border-radius: 24px;
		padding: 24px;
		margin: 10px 14px;
		box-shadow: 0 4px 20px rgba(0, 102, 255, 0.05);
	}

	.total-assets-box {
		margin-bottom: 20px;
	}

	.assets-label {
		font-size: 13px;
		color: #7b87a0;
		margin-bottom: 6px;
	}

	.assets-value {
		font-size: 32px;
		font-weight: 800;
		color: #1a1a1a;
	}

	.divider {
		height: 1px;
		background-color: #f0f3ff;
		margin-bottom: 24px;
	}

	/* 概览章节 */
	.overview-section {
		margin-bottom: 32px;
	}

	.no-margin {
		margin-bottom: 0;
	}

	.section-header {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 16px;
	}

